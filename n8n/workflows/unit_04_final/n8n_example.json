    {
      "parameters": {
        "jsCode": "// 準備用來做品質檢查的測試問題\nconst testQueries = [\n    '公司的主要產品有哪些？',\n    '退貨政策是什麼？',\n    '如何聯絡客服？',\n    '電子鎖沒電了怎麼辦？',\n    '如何設定指紋解鎖？',\n    '安裝門鎖需要另外收費嗎？'\n];\n\n// 使用 JavaScript 內建的數學函式來隨機抽取一個問題\nconst randomIndex = Math.floor(Math.random() * testQueries.length);\nconst query = testQueries[randomIndex];\n\nreturn [{\n    json: {\n        testQuery: query\n    }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4880,
        4576
      ],
      "id": "fb102732-7cfa-49aa-844a-fe6ced392ae6",
      "name": "Code — Prepare Test Query"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\n// 1. 處理所有檢索回來的資料\nfor (const item of items) {\n    const doc = item.json || {};\n    const documentObj = doc.document || {};\n    // 擷取前 100 個字元作為預覽\n    const contentPreview = (documentObj.pageContent || '').substring(0, 100);\n    const metadata = documentObj.metadata || {};\n    \n    results.push({\n        content_preview: contentPreview,\n        metadata: metadata\n    });\n}\n\nconst hasResults = results.length > 0;\n// 取得上一層傳過來的測試問句\nconst query = items.length > 0 ? (items[0].json.testQuery || 'N/A') : 'N/A';\n\n// 2. 格式化當前時間 (MM/DD HH:MM)\nconst now = new Date();\nconst timeStr = String(now.getMonth() + 1).padStart(2, '0') + '/' + \n                String(now.getDate()).padStart(2, '0') + ' ' + \n                String(now.getHours()).padStart(2, '0') + ':' + \n                String(now.getMinutes()).padStart(2, '0');\n\nlet msg = '';\nlet quality = '';\n\n// 3. 組合報告內容 (JS 可以完美支援 Emoji)\nif (hasResults) {\n    const previews = results.slice(0, 3).map((r, i) => `  ${i + 1}. ${r.content_preview}...`).join('\\n');\n    msg = `📊 每週品質報告\\n測試問句：${query}\\n檢索結果：${results.length} 筆\\n${previews}\\n狀態：✅ 正常\\n時間：${timeStr}`;\n    quality = 'OK';\n} else {\n    msg = `📊 每週品質報告\\n測試問句：${query}\\n⚠️ 檢索結果為空！請檢查 Pinecone 索引\\n時間：${timeStr}`;\n    quality = 'FAIL';\n}\n\nreturn [{\n    json: {\n        quality: quality,\n        resultCount: results.length,\n        lineMessage: msg\n    }\n}];"
      },
