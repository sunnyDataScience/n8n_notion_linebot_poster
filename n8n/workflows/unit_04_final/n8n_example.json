    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "python",
        "pythonCode": "from datetime import datetime\n\nitem = _input.all()[0].json\nwf = item.get('workflow', {})\nexec_data = item.get('execution', {})\nerr = exec_data.get('error', {})\n\nreturn [{'json': {\n    'errorType': 'WORKFLOW_ERROR',\n    'workflowName': wf.get('name', 'unknown'),\n    'workflowId': str(wf.get('id', '')),\n    'errorMessage': err.get('message', 'unknown error'),\n    'executionId': str(exec_data.get('id', '')),\n    'timestamp': datetime.now().strftime('%Y-%m-%d %H:%M:%S'),\n    'severity': 'HIGH',\n    'lineMessage': f\"⚠️ Workflow 錯誤！\\n\"\n                   f\"流程：{wf.get('name', 'unknown')}\\n\"\n                   f\"錯誤：{err.get('message', 'unknown')}\\n\"\n                   f\"時間：{datetime.now().strftime('%m/%d %H:%M')}\"\n}}]"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
