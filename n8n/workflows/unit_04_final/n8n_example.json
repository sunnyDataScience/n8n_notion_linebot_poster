    {
      "parameters": {
        "jsCode": "// 取得第一筆資料的 JSON\nconst j = $input.first().json || {};\nconst wf = j.workflow || {};\nconst exec_data = j.execution || {};\nconst err = exec_data.error || {};\n\n// 處理當前時間\nconst now = new Date();\n// 格式化為 YYYY-MM-DD HH:mm:SS\nconst fullTime = now.getFullYear() + '-' + \n                 String(now.getMonth() + 1).padStart(2, '0') + '-' + \n                 String(now.getDate()).padStart(2, '0') + ' ' + \n                 String(now.getHours()).padStart(2, '0') + ':' + \n                 String(now.getMinutes()).padStart(2, '0') + ':' + \n                 String(now.getSeconds()).padStart(2, '0');\n// 格式化為 MM/DD HH:mm\nconst shortTime = String(now.getMonth() + 1).padStart(2, '0') + '/' + \n                  String(now.getDate()).padStart(2, '0') + ' ' + \n                  String(now.getHours()).padStart(2, '0') + ':' + \n                  String(now.getMinutes()).padStart(2, '0');\n\nconst wfName = wf.name || 'unknown';\nconst errMsg = err.message || 'unknown error';\n\nreturn [{\n    json: {\n        errorType: 'WORKFLOW_ERROR',\n        workflowName: wfName,\n        workflowId: String(wf.id || ''),\n        errorMessage: errMsg,\n        executionId: String(exec_data.id || ''),\n        timestamp: fullTime,\n        severity: 'HIGH',\n        lineMessage: `⚠️ Workflow 錯誤！\\n流程：${wfName}\\n錯誤：${errMsg}\\n時間：${shortTime}`\n    }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4880,
