    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst count = items.length;\nconst titles = [];\n\n// 只取前 5 筆資料\nfor (let i = 0; i < Math.min(5, count); i++) {\n    const j = items[i].json || {};\n    const props = j.properties || {};\n    const name_prop = (props.Name || {}).title || [];\n    \n    let title = 'untitled';\n    if (name_prop.length > 0) {\n        title = (name_prop[0].text || {}).content || 'untitled';\n    }\n    titles.push(`  - ${title}`);\n}\n\nconst more = count > 5 ? `\\n  ...還有 ${count - 5} 筆` : '';\nconst titleList = titles.join('\\n');\n\n// 取得當前時間並格式化為 MM/DD HH:MM\nconst now = new Date();\nconst shortTime = String(now.getMonth() + 1).padStart(2, '0') + '/' + \n                  String(now.getDate()).padStart(2, '0') + ' ' + \n                  String(now.getHours()).padStart(2, '0') + ':' + \n                  String(now.getMinutes()).padStart(2, '0');\n\n// 將 🔄 替換為 [巡檢] 避免編碼錯誤\nconst msg = `[巡檢] 每晚巡檢報告\\n發現 ${count} 筆待索引頁面\\n${titleList}${more}\\n時間：${shortTime}`;\n\nreturn [{ json: { pendingCount: count, lineMessage: msg } }];"
      },
      "type": "n8n-nodes-base.code",
