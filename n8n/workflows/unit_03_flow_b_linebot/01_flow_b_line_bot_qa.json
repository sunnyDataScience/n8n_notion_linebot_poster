{
  "name": "[Unit 3] Flow B — LINE Bot Q&A Service",
  "nodes": [
    {
      "parameters": {
        "content": "## Flow B: LINE Bot 智慧問答服務\n\n### 流程說明\n1. **Webhook** - 接收 LINE 使用者傳送的訊息\n2. **Set** - 擷取使用者訊息、replyToken 與 userId\n3. **Embeddings OpenAI** - 將使用者問題向量化\n4. **Pinecone Vector Store** - 相似度搜尋知識庫（topK=3）\n5. **OpenAI Chat** - 根據檢索到的上下文，由 AI 產生回答（附來源連結）\n6. **HTTP Request** - 呼叫 LINE Reply API 將回答傳回給使用者\n\n### 使用前準備\n- 替換 `LINE_CHANNEL_ACCESS_TOKEN` 為你的 LINE Channel Access Token\n- 替換 `YOUR_PINECONE_INDEX` 為你的 Pinecone 索引名稱\n- 設定 OpenAI 憑證（`openai_api`）\n- 設定 Pinecone 憑證（`pinecone_api`）\n- 將 Webhook URL 設定到 LINE Developers Console 的 Webhook URL 欄位",
        "height": 380,
        "width": 560
      },
      "id": "sticky-note-1",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        250,
        50
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "line-webhook",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-1",
      "name": "LINE Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        250,
        500
      ],
      "webhookId": "line-webhook-id"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "set-user-message",
              "name": "userMessage",
              "value": "={{ $json.body.events[0].message.text }}",
              "type": "string"
            },
            {
              "id": "set-reply-token",
              "name": "replyToken",
              "value": "={{ $json.body.events[0].replyToken }}",
              "type": "string"
            },
            {
              "id": "set-user-id",
              "name": "userId",
              "value": "={{ $json.body.events[0].source.userId }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-1",
      "name": "Extract Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        500,
        500
      ]
    },
    {
      "parameters": {
        "model": "text-embedding-ada-002",
        "options": {}
      },
      "id": "embeddings-openai-1",
      "name": "Embeddings OpenAI",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1,
      "position": [
        750,
        700
      ],
      "credentials": {
        "openAiApi": {
          "id": "openai_api",
          "name": "openai_api"
        }
      }
    },
    {
      "parameters": {
        "mode": "retrieve",
        "pineconeIndex": "YOUR_PINECONE_INDEX",
        "topK": 3,
        "options": {}
      },
      "id": "pinecone-1",
      "name": "Pinecone Vector Store",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePinecone",
      "typeVersion": 1,
      "position": [
        750,
        500
      ],
      "credentials": {
        "pineconeApi": {
          "id": "pinecone_api",
          "name": "pinecone_api"
        }
      }
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "content": "You are a knowledge base assistant. Answer the user's question based on the provided context. Always include source links if available in the context. Reply in Traditional Chinese (繁體中文). If the context does not contain enough information to answer, honestly say you don't know.\n\n### Retrieved Context:\n{{ $('Pinecone Vector Store').item.json.documents.map(doc => doc.pageContent).join('\\n\\n---\\n\\n') }}\n\n### User Question:\n{{ $('Extract Message').item.json.userMessage }}",
              "role": "user"
            }
          ]
        },
        "options": {
          "systemMessage": "You are a knowledge base assistant. Answer based on the provided context. Include source links. Reply in Traditional Chinese.",
          "temperature": 0.3,
          "maxTokens": 1024
        }
      },
      "id": "openai-chat-1",
      "name": "OpenAI Chat",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
        1000,
        500
      ],
      "credentials": {
        "openAiApi": {
          "id": "openai_api",
          "name": "openai_api"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.line.me/v2/bot/message/reply",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer LINE_CHANNEL_ACCESS_TOKEN"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"replyToken\": \"{{ $('Extract Message').item.json.replyToken }}\",\n  \"messages\": [\n    {\n      \"type\": \"text\",\n      \"text\": \"{{ $('OpenAI Chat').item.json.message.content }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "http-request-1",
      "name": "LINE Reply API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1250,
        500
      ]
    }
  ],
  "connections": {
    "LINE Webhook": {
      "main": [
        [
          {
            "node": "Extract Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Message": {
      "main": [
        [
          {
            "node": "Pinecone Vector Store",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Embeddings OpenAI": {
      "ai_embedding": [
        [
          {
            "node": "Pinecone Vector Store",
            "type": "ai_embedding",
            "index": 0
          }
        ]
      ]
    },
    "Pinecone Vector Store": {
      "main": [
        [
          {
            "node": "OpenAI Chat",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Chat": {
      "main": [
        [
          {
            "node": "LINE Reply API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "staticData": null,
  "settings": {
    "executionOrder": "v1"
  },
  "triggerCount": 1,
  "tags": [],
  "active": false,
  "versionId": "1"
}
