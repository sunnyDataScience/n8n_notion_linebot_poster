{
  "name": "[Unit 4] Flow C-2 — Nightly Auto-Reindex",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 0,
              "triggerAtMinute": 0
            }
          ]
        },
        "options": {
          "timezone": "Asia/Taipei"
        }
      },
      "id": "schedule-trigger",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "getAll",
        "databaseId": {
          "__rl": true,
          "value": "YOUR_NOTION_INDEX_LOG_DB_ID",
          "mode": "id"
        },
        "returnAll": true,
        "filterType": "manual",
        "filters": {
          "conditions": [
            {
              "key": "status",
              "condition": "equals",
              "value": "NEW"
            }
          ]
        },
        "options": {}
      },
      "id": "notion-query",
      "name": "Query Index Log DB",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [500, 300],
      "credentials": {
        "notionApi": {
          "id": "notion_api",
          "name": "Notion API"
        }
      },
      "notes": "Query pages where status=NEW or last_indexed_at is older than 24h. Adjust filter in Notion node UI to add OR condition for expired last_indexed_at."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-items-exist",
              "leftValue": "={{ $input.all().length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-has-items",
      "name": "Has Items to Reindex?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [750, 300]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "split-in-batches",
      "name": "Loop Over Items",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1000, 200]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "FLOW_A_WORKFLOW_ID",
          "mode": "id"
        },
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "execute-workflow",
      "name": "Execute Flow A",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [1250, 200]
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "update",
        "pageId": {
          "__rl": true,
          "value": "={{ $('Loop Over Items').item.json.id }}",
          "mode": "id"
        },
        "propertiesUi": {
          "propertyValues": [
            {
              "key": "status",
              "selectValue": "REINDEXED"
            },
            {
              "key": "last_indexed_at",
              "date": "={{ $now.toISO() }}"
            }
          ]
        },
        "options": {}
      },
      "id": "notion-update",
      "name": "Update Status → REINDEXED",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [1500, 200],
      "credentials": {
        "notionApi": {
          "id": "notion_api",
          "name": "Notion API"
        }
      }
    },
    {
      "parameters": {
        "content": "## 守門員流程（定時補索引）\n每晚自動檢查有沒有漏掉的文件，找到就重新跑 Flow A 補上索引。\n\n**排程**：每天 00:00（Asia/Taipei）\n**流程**：查詢 Index Log → 過濾 status=NEW → 逐筆觸發 Flow A → 更新狀態為 REINDEXED",
        "height": 220,
        "width": 500,
        "color": 4
      },
      "id": "sticky-note",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [250, 500]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Query Index Log DB",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Query Index Log DB": {
      "main": [
        [
          {
            "node": "Has Items to Reindex?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Items to Reindex?": {
      "main": [
        [
          {
            "node": "Loop Over Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop Over Items": {
      "main": [
        null,
        [
          {
            "node": "Execute Flow A",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute Flow A": {
      "main": [
        [
          {
            "node": "Update Status → REINDEXED",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update Status → REINDEXED": {
      "main": [
        [
          {
            "node": "Loop Over Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "timezone": "Asia/Taipei"
  },
  "staticData": null,
  "tags": [],
  "triggerCount": 1,
  "updatedAt": "2026-03-19T00:00:00.000Z",
  "versionId": "1"
}
