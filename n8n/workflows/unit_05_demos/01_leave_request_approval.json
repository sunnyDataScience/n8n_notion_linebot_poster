{
  "name": "[Unit 5 Demo] Leave Request Approval",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "leave-request",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "LINE Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [0, 0],
      "webhookId": "leave-request"
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "field-employee_name",
              "name": "employee_name",
              "value": "={{ $json.body.employee_name }}",
              "type": "string"
            },
            {
              "id": "field-leave_type",
              "name": "leave_type",
              "value": "={{ $json.body.leave_type }}",
              "type": "string"
            },
            {
              "id": "field-start_date",
              "name": "start_date",
              "value": "={{ $json.body.start_date }}",
              "type": "string"
            },
            {
              "id": "field-end_date",
              "name": "end_date",
              "value": "={{ $json.body.end_date }}",
              "type": "string"
            },
            {
              "id": "field-days",
              "name": "days",
              "value": "={{ $json.body.days }}",
              "type": "number"
            },
            {
              "id": "field-reason",
              "name": "reason",
              "value": "={{ $json.body.reason }}",
              "type": "string"
            },
            {
              "id": "field-replyToken",
              "name": "replyToken",
              "value": "={{ $json.body.replyToken }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000002",
      "name": "Extract Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0]
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "create",
        "databaseId": {
          "__rl": true,
          "value": "YOUR_NOTION_LEAVE_DB_ID",
          "mode": "id"
        },
        "propertiesUi": {
          "propertyValues": [
            {
              "key": "員工姓名|title",
              "title": "={{ $json.employee_name }}"
            },
            {
              "key": "假別|select",
              "selectValue": "={{ $json.leave_type }}"
            },
            {
              "key": "開始日期|date",
              "dateValue": "={{ $json.start_date }}"
            },
            {
              "key": "結束日期|date",
              "dateValue": "={{ $json.end_date }}"
            },
            {
              "key": "天數|number",
              "numberValue": "={{ $json.days }}"
            },
            {
              "key": "事由|rich_text",
              "textContent": "={{ $json.reason }}"
            },
            {
              "key": "狀態|select",
              "selectValue": "PENDING"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000003",
      "name": "Create Leave Request",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [440, 0],
      "credentials": {
        "notionApi": {
          "id": "notion_api",
          "name": "Notion API"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-days",
              "leftValue": "={{ $json.days }}",
              "rightValue": 3,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000004",
      "name": "Days > 3?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.line.me/v2/bot/message/push",
        "authentication": "genericCredentialType",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "Bearer LINE_CHANNEL_ACCESS_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"to\": \"MANAGER_LINE_USER_ID\",\n  \"messages\": [\n    {\n      \"type\": \"text\",\n      \"text\": \"請假審批通知\\n員工：{{ $json.employee_name }}\\n假別：{{ $json.leave_type }}\\n天數：{{ $json.days }}\\n事由：{{ $json.reason }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000005",
      "name": "Notify Manager",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, -150]
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "update",
        "pageId": {
          "__rl": true,
          "value": "={{ $('Create Leave Request').item.json.id }}",
          "mode": "id"
        },
        "propertiesUi": {
          "propertyValues": [
            {
              "key": "狀態|select",
              "selectValue": "APPROVED"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000006",
      "name": "Auto Approve",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [880, 150],
      "credentials": {
        "notionApi": {
          "id": "notion_api",
          "name": "Notion API"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.line.me/v2/bot/message/reply",
        "authentication": "genericCredentialType",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "Bearer LINE_CHANNEL_ACCESS_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"replyToken\": \"{{ $('Extract Fields').item.json.replyToken }}\",\n  \"messages\": [\n    {\n      \"type\": \"text\",\n      \"text\": \"您的請假申請已自動核准\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000007",
      "name": "Notify Employee",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 150]
    },
    {
      "parameters": {
        "content": "### 【Demo】請假流程自動化\n\nLINE 送出請假 → 寫入 Notion → 3天以內自動核准 / 超過3天通知主管審批。\n\n**共用元件：**LINE Webhook、Notion DB、IF 分流、LINE 推播",
        "height": 220,
        "width": 460,
        "color": 4
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000008",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-60, -320]
    }
  ],
  "connections": {
