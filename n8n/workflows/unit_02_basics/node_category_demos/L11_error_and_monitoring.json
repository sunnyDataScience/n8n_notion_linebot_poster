      "parameters": {"mode": "runOnceForAllItems", "jsCode": "const items = $input.all();\nconst today = new Date();\nreturn items.map(i => { const deal = i.json; const closeDate = new Date(deal.expectedCloseDate); const daysRemaining = Math.ceil((closeDate - today) / (1000*60*60*24)); const isOverdue = daysRemaining < 0; const status = isOverdue ? 'OVERDUE' : (daysRemaining <= 14 ? 'URGENT' : 'ON_TRACK'); return { json: { ...deal, daysRemaining, isOverdue, status, alertNeeded: isOverdue || daysRemaining <= 14, timestamp: $now.toISO() }}; });"},
