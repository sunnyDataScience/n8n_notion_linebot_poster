      "id": "4601840e-8fcb-4c89-a7e9-d078804bbc06",
      "name": "Set — 計算加權金額與佣金",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        400
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst totalAmount = items.reduce((s, i) => s + i.json.amount, 0);\nconst totalWeighted = items.reduce((s, i) => s + i.json.weightedAmount, 0);\nconst totalCommission = items.reduce((s, i) => s + i.json.commission, 0);\n\nconst byRep = {};\nitems.forEach(i => {\n  const rep = i.json.salesRep;\n  if (!byRep[rep]) byRep[rep] = { deals: 0, amount: 0 };\n  byRep[rep].deals++;\n  byRep[rep].amount += i.json.amount;\n});\n\nconst lines = items.map(i =>\n  `${i.json.customer}  ${i.json.product}  $${i.json.amount.toLocaleString()}  [${i.json.stage}]`\n);\n\nconst repLines = Object.entries(byRep).map(([rep, data]) =>\n  `${rep}：${data.deals} 筆，$${data.amount.toLocaleString()}`\n);\n\nconst report = [\n  '╔══════════════════════════════════╗',\n  '║      業務銷售 Pipeline 報表       ║',\n  '╠══════════════════════════════════╣',\n  `║ 商機數：${items.length} 筆`,\n  `║ 總金額：$${totalAmount.toLocaleString()}`,\n  `║ 加權金額：$${totalWeighted.toLocaleString()}`,\n  `║ 預估佣金：$${totalCommission.toLocaleString()}`,\n  '╠──── 各業務統計 ────────────────╣',\n  ...repLines.map(l => `║ ${l}`),\n  '╠──── 商機明細 ──────────────────╣',\n  ...lines.map(l => `║ ${l}`),\n  '╚══════════════════════════════════╝'\n].join('\\n');\n\nreturn [{ json: {\n  totalDeals: items.length,\n  totalAmount,\n  totalWeighted,\n  totalCommission,\n  report\n}}];"
      },
      "id": "1de15352-1b19-498d-b3af-c72021d5e380",
      "name": "Code — 彙總業績報表",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
