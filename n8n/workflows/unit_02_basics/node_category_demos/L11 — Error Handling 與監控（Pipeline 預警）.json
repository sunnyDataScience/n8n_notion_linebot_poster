    },
    {
      "parameters": {
        "jsCode": "// 取得今天的日期並將時間歸零（為了準確計算天數差）\nconst today = new Date();\ntoday.setHours(0, 0, 0, 0);\n\nconst results = [];\n\n// JS 環境中可以使用 $input.all()\nfor (const i of $input.all()) {\n    // 複製原本的 json 字典\n    const deal = { ...(i.json || {}) };\n    const close_str = deal.expectedCloseDate || '';\n    let days_remaining = 999;\n\n    // 解析日期並計算天數差\n    if (close_str) {\n        const close_date = new Date(close_str);\n        if (!isNaN(close_date.getTime())) {\n            close_date.setHours(0, 0, 0, 0);\n            const diffTime = close_date - today;\n            // 將毫秒轉換為天數\n            days_remaining = Math.ceil(diffTime / (1000 * 60 * 60 * 24));\n        }\n    }\n\n    const is_overdue = days_remaining < 0;\n    const status = is_overdue ? 'OVERDUE' : (days_remaining <= 14 ? 'URGENT' : 'ON_TRACK');\n\n    // 將計算結果更新回 deal 物件中\n    Object.assign(deal, {\n        daysRemaining: days_remaining,\n        isOverdue: is_overdue,\n        status: status,\n        alertNeeded: is_overdue || days_remaining <= 14,\n        timestamp: new Date().toISOString()\n    });\n\n    results.push({ json: deal });\n}\n\nreturn results;"
      },
