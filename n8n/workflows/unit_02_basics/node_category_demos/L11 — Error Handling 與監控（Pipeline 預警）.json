      "parameters": {
        "jsCode": "// 取得第一筆資料的 JSON 內容\nconst j = $input.first().json || {};\nconst wf = j.workflow || {};\nconst exec_data = j.execution || {};\nconst err = exec_data.error || {};\n\nreturn [{\n    json: {\n        type: 'ERROR',\n        workflow: wf.name || 'unknown',\n        message: err.message || 'unknown',\n        executionId: String(exec_data.id || ''),\n        timestamp: new Date().toISOString(), // JS 原生語法，不需 import 任何模組\n        severity: 'HIGH'\n    }\n}];"
      },
