{
  "name": "Demo 6 — Observability (出餐紀錄+客訴)",
  "nodes": [
    {
      "parameters": {},
      "id": "c7bbc737-9d7d-44f2-ad25-9a6f623c2e52",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{ json: {\n  type: 'ERROR',\n  workflow: $json.workflow?.name || 'unknown',\n  message: $json.execution?.error?.message || 'unknown',\n  executionId: String($json.execution?.id || ''),\n  timestamp: $now.toISO(),\n  severity: 'HIGH'\n}}];"
      },
      "id": "fe788290-15bc-4e34-af96-6a53293f4b42",
      "name": "Code — 萃取錯誤",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            { "id": "1", "name": "action", "value": "通知店長 + 寫入日誌資料庫", "type": "string" },
            { "id": "2", "name": "notifyChannel", "value": "#incidents", "type": "string" }
          ]
        }
      },
      "id": "d06c3a18-15e4-43b5-aa40-ec9d8e1ce771",
      "name": "Set — 格式化客訴記錄",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [740, 300]
    },
    {
      "parameters": {},
      "id": "893b5702-0ad5-4a63-a51d-3778fab05a7c",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [200, 700]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $json;\nconst prepMin = (item.prepTimeMs / 60000).toFixed(1);\nconst slaLimit = 5; // minutes\nconst sla = parseFloat(prepMin) <= slaLimit ? 'PASS' : 'SLA_BREACH';\n\nreturn [{ json: {\n  type: 'COMPLETION',\n  orderId: item.orderId,\n  item: item.item,\n  customer: item.customer,\n  prepTime: `${prepMin} 分鐘`,\n  slaLimit: `${slaLimit} 分鐘`,\n  slaStatus: sla,\n  alertNeeded: sla === 'SLA_BREACH',\n  timestamp: $now.toISO()\n}}];"
      },
      "id": "77ddf085-fee7-48ef-a8a1-518a40814457",
      "name": "Code — 計算出餐時間 + SLA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 700]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            { "leftValue": "={{ $json.alertNeeded }}", "operator": { "type": "boolean", "operation": "true" }, "rightValue": "" }
          ]
        }
      },
      "id": "if-sla",
      "name": "IF — SLA 超時？",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [740, 700]
    },
    {
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            { "id": "1", "name": "alertAction", "value": "立即通知店長：出餐超時！", "type": "string" }
          ]
        }
      },
      "id": "set-alert",
      "name": "Set — 發送超時警報",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1000, 620]
    },
    {
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            { "id": "1", "name": "alertAction", "value": "正常記錄，無需警報", "type": "string" }
          ]
