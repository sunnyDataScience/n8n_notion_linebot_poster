      "id": "893b5702-0ad5-4a63-a51d-3778fab05a7c",
      "name": "Fake Sales",
      "type": "n8n-nodes-fake-sales.fakeSales",
      "typeVersion": 1,
      "position": [
        200,
        700
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst today = new Date();\n\nreturn items.map(i => {\n  const deal = i.json;\n  const closeDate = new Date(deal.expectedCloseDate);\n  const daysRemaining = Math.ceil((closeDate - today) / (1000 * 60 * 60 * 24));\n  const isOverdue = daysRemaining < 0;\n  const status = isOverdue ? 'OVERDUE' : (daysRemaining <= 14 ? 'URGENT' : 'ON_TRACK');\n\n  return { json: {\n    ...deal,\n    type: 'DEAL_MONITOR',\n    daysRemaining,\n    isOverdue,\n    status,\n    alertNeeded: isOverdue || daysRemaining <= 14,\n    timestamp: $now.toISO()\n  }};\n});"
      },
      "id": "77ddf085-fee7-48ef-a8a1-518a40814457",
      "name": "Code — 計算到期天數 + 狀態",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        700
      ]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.alertNeeded }}",
              "operator": {
                "type": "boolean",
                "operation": "true"
              },
              "rightValue": ""
            }
          ],
          "combinator": "and",
          "options": {
            "version": 1,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          }
        }
      },
      "id": "ae4c466d-e25b-433e-9f51-9d4b3487fca4",
      "name": "IF — 需要警報？",
