          "values": [
            {
              "role": "system",
              "content": "You are a multimodal knowledge base assistant. The user may have asked via text, sent an image, voice message, or video. The querySource field tells you how they asked. Answer based ONLY on the provided context from the knowledge base. Include source links when available. If the context doesn't contain relevant information, say so honestly. Always reply in Traditional Chinese. Format your response clearly and concisely for LINE messaging (keep under 2000 characters)."
            },
            {
              "role": "user",
              "content": "=Query source: {{ $json.querySource }}\nUser query: {{ $json.queryText }}\n\nRetrieved context:\n{{ $json.retrievedDocuments }}"
            }
          ]
        },
        "options": {
          "temperature": 0.3
        }
      },
