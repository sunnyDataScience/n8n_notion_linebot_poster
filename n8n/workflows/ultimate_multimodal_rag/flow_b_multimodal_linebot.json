{
  "name": "[Ultimate] Flow B — Multimodal LINE Bot",
  "nodes": [
    {
      "parameters": { "events": ["message"] },
      "id": "dc23a57b-cdd0-4d2c-b7f7-7420afb1a486",
      "name": "Line Messaging Trigger",
      "type": "@aotoki/n8n-nodes-line-messaging.lineMessagingTrigger",
      "typeVersion": 1,
      "position": [-16, 600],
      "credentials": {
        "lineMessagingApi": { "id": "LINE_MESSAGING_CREDENTIAL_ID", "name": "LINE Messaging API" }
      }
    },
    {
      "parameters": {
        "jsCode": "// Route by message type — returns items only if type matches\nconst items = $input.all();\nconst msgType = items[0]?.json?.message?.type || '';\nconst replyToken = items[0]?.json?.replyToken || '';\n\nif (msgType === 'text') {\n  return [{ json: { queryText: items[0].json.message.text, replyToken, branch: 'text' } }];\n}\nif (msgType === 'image') {\n  return [{ json: { ...items[0].json, replyToken, branch: 'image' } }];\n}\nif (msgType === 'audio') {\n  return [{ json: { ...items[0].json, replyToken, branch: 'audio' } }];\n}\nif (msgType === 'video') {\n  return [{ json: { ...items[0].json, replyToken, branch: 'video' } }];\n}\nreturn [{ json: { replyToken, branch: 'unsupported' } }];"
      },
      "id": "e4f5a6b7-1234-4ccc-d567-111111111111",
      "name": "Code — Classify Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [200, 600]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nif (item.json.branch === 'text') return [item];\nreturn [];"
      },
      "id": "f7a8b9c0-0001-4ddd-e678-222222222222",
      "name": "Route — Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nif (item.json.branch === 'image') return [item];\nreturn [];"
      },
      "id": "f7a8b9c0-0002-4ddd-e678-222222222222",
      "name": "Route — Image",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 600]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nif (item.json.branch === 'audio') return [item];\nreturn [];"
      },
      "id": "f7a8b9c0-0003-4ddd-e678-222222222222",
      "name": "Route — Audio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 900]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nif (item.json.branch === 'video') return [item];\nreturn [];"
      },
      "id": "f7a8b9c0-0004-4ddd-e678-222222222222",
      "name": "Route — Video",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 1200]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nif (item.json.branch === 'unsupported') return [item];\nreturn [];"
      },
      "id": "f7a8b9c0-0005-4ddd-e678-222222222222",
      "name": "Route — Unsupported",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 1500]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api-data.line.me/v2/bot/message/{{ $json.message.id }}/content",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $vars.LINE_CHANNEL_ACCESS_TOKEN }}" }
          ]
        },
        "options": { "response": { "responseFormat": "file" } }
      },
      "id": "a1c2d3e4-3456-4eee-f789-333333333333",
      "name": "HTTP Request — Download Image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 600]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAIApi",
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"model\": \"gpt-4o\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Describe what you see in this image in detail. If there is text, transcribe it. Then generate a concise search query (in Traditional Chinese) that captures the key topic. Return: Description: <desc>\\nSearch Query: <query>\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": [\n        {\n          \"type\": \"image_url\",\n          \"image_url\": {\n            \"url\": \"data:image/jpeg;base64,{{ $binary.data.data }}\"\n          }\n        }\n      ]\n    }\n  ],\n  \"max_tokens\": 1000\n}"
      },
      "id": "b2d3e4f5-4567-4fff-a890-444444444444",
      "name": "HTTP Request — OpenAI Vision",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [950, 600],
      "credentials": {
        "openAIApi": { "id": "OPENAI_CREDENTIAL_ID", "name": "OpenAI account" }
      }
    },
