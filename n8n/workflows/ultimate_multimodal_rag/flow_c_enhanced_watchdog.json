      "id": "a1b2c3d4-0018-4a00-b000-000000000018",
      "name": "Set — Quality Fail",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1500, 700]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst passed = items.filter(i => i.json.result === 'PASS').length;\nconst failed = items.filter(i => i.json.result === 'FAIL');\nconst total = items.length;\n\nconst failList = failed.map(f => `- ${f.json.testQuery}`).join('\\n');\n\nlet suggestion = '';\nif (failed.length > 0) {\n  suggestion = '\\n\\n建議：請重新執行索引流程以改善搜尋品質';\n}\n\nreturn [{\n  json: {\n    passed,\n    total,\n    failedQueries: failList,\n    report: `📊 每週品質報告\\n\\n通過：${passed}/${total}\\n失敗項目：\\n${failList || '(無)'}${suggestion}`\n  }\n}];"
      },
