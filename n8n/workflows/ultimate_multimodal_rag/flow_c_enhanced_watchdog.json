        "language": "python",
        "pythonCode": "return [\n    {\"json\": {\"query\": \"去年迎新場地在哪裡租的？\", \"topScore\": 0.0}},\n    {\"json\": {\"query\": \"社費收支報告\", \"topScore\": 0.0}},\n    {\"json\": {\"query\": \"幹部交接清單\", \"topScore\": 0.0}},\n]"
      },
      "id": "7749c857-f291-45da-a9df-e5814cd9c6bd",
      "name": "Code — Test Queries",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        640
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "python",
        "pythonCode": "items = _input.all()\nthreshold = 0.7\npassed = sum(1 for i in items if (i.json.get(\"topScore\") or 0) > threshold)\nfailed = [i.json.get(\"query\", \"\") for i in items if (i.json.get(\"topScore\") or 0) <= threshold]\nreport = f\"Weekly Quality Report\\nPassed: {passed}/{len(items)}\"\nif failed:\n    failed_list = \"\\n\".join(f\"- {q}\" for q in failed)\n    report += f\"\\nFailed:\\n{failed_list}\\n\\n目前這裡仍是 placeholder，下一版再補 embedding + Pinecone query。\"\nelse:\n    report += \"\\n\\nAll tests passed!\"\nreturn [{\"json\": {\"report\": report}}]"
      },
