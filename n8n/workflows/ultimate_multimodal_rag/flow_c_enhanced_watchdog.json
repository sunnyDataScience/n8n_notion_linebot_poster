        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"filter\": {\n    \"or\": [\n      {\n        \"property\": \"Status\",\n        \"select\": { \"equals\": \"NEW\" }\n      },\n      {\n        \"property\": \"Status\",\n        \"select\": { \"equals\": \"FAILED\" }\n      }\n    ]\n  },\n  \"sorts\": [\n    { \"timestamp\": \"created_time\", \"direction\": \"ascending\" }\n  ],\n  \"page_size\": 50\n}"
      },
      "id": "41df776f-b3ac-4c7e-9c5e-37654e29da53",
