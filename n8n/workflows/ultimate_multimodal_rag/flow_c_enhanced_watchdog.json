        "body": "={\n  \"parent\": {\n    \"type\": \"data_source_id\",\n    \"data_source_id\": \"YOUR_ERROR_LOG_DATA_SOURCE_ID\"\n  },\n  \"properties\": {\n    \"Name\": {\n      \"title\": [\n        {\n          \"text\": {\n            \"content\": `Error - ${$json.workflowName}`\n          }\n        }\n      ]\n    },\n    \"Workflow Name\": {\n      \"rich_text\": [\n        {\n          \"text\": {\n            \"content\": $json.workflowName\n          }\n        }\n      ]\n    },\n    \"Error Message\": {\n      \"rich_text\": [\n        {\n          \"text\": {\n            \"content\": String($json.errorMessage).slice(0, 1800)\n          }\n        }\n      ]\n    },\n    \"Execution ID\": {\n      \"rich_text\": [\n        {\n          \"text\": {\n            \"content\": $json.executionId\n          }\n        }\n      ]\n    },\n    \"Timestamp\": {\n      \"date\": {\n        \"start\": $json.timestamp\n      }\n    },\n    \"Status\": {\n      \"select\": {\n        \"name\": \"UNRESOLVED\"\n      }\n    }\n  }\n}"
