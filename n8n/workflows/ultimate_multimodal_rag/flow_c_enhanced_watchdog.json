      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "python",
        "pythonCode": "j = _input.first().json\nresults = j.get(\"results\") or []\noutput = []\nfor page in results:\n    props = page.get(\"properties\") or {}\n    name_title = (props.get(\"Name\") or {}).get(\"title\") or []\n    title = \"\"\n    if name_title:\n        title = name_title[0].get(\"plain_text\", \"\") or (name_title[0].get(\"text\") or {}).get(\"content\", \"\")\n    status_sel = (props.get(\"Status\") or {}).get(\"select\") or {}\n    status_stat = (props.get(\"Status\") or {}).get(\"status\") or {}\n    status = status_sel.get(\"name\", \"\") or status_stat.get(\"name\", \"\")\n    source_rt = (props.get(\"Source\") or {}).get(\"rich_text\") or []\n    source = source_rt[0].get(\"plain_text\", \"\") if source_rt else \"\"\n    output.append({\"json\": {\n        \"pageId\": page.get(\"id\", \"\"),\n        \"title\": title,\n        \"status\": status,\n        \"source\": source,\n        \"originalPage\": page,\n    }})\nreturn output"
      },
