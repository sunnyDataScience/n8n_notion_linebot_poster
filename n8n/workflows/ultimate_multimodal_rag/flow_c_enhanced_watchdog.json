        "language": "python",
        "pythonCode": "j = _input.first().json\nworkflow_info = j.get(\"workflow\") or {}\nexecution_info = j.get(\"execution\") or {}\nerror_info = execution_info.get(\"error\") or {}\nreturn [{\"json\": {\n    \"workflowName\": workflow_info.get(\"name\", \"unknown\"),\n    \"errorMessage\": error_info.get(\"message\", \"unknown error\"),\n    \"timestamp\": _now.isoformat(),\n    \"executionId\": str(execution_info.get(\"id\", \"unknown\")),\n}}]"
