      "id": "a0010001-0002-4a00-b002-000000000002",
      "name": "Download File",
      "credentials": { "googleDriveOAuth2Api": { "id": "GOOGLE_DRIVE_CREDENTIAL_ID", "name": "Google Drive account" } }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst mime = items[0]?.json?.mimeType || items[0]?.binary?.data?.mimeType || '';\nconst fileId = items[0]?.json?.id || '';\nconst fileName = items[0]?.json?.name || '';\nconst modifiedTime = items[0]?.json?.modifiedTime || '';\n\n// MinerU-eligible: PDF, DOCX, PPTX\nif (mime === 'application/pdf' ||\n    mime === 'application/vnd.openxmlformats-officedocument.wordprocessingml.document' ||\n    mime === 'application/vnd.openxmlformats-officedocument.presentationml.presentation' ||\n    mime === 'application/msword' ||\n    mime === 'application/vnd.ms-powerpoint') {\n  return [{ json: { ...items[0].json, route: 'mineru', source: 'drive', fileId, fileName, modifiedTime } }];\n}\nif (mime.startsWith('text/')) {\n  return [{ json: { ...items[0].json, route: 'text', source: 'drive', fileId, fileName, modifiedTime } }];\n}\nif (mime.startsWith('image/')) {\n  return [{ json: { ...items[0].json, route: 'image', source: 'drive', fileId, fileName, modifiedTime }, binary: items[0].binary }];\n}\nif (mime.startsWith('audio/')) {\n  return [{ json: { ...items[0].json, route: 'audio', source: 'drive', fileId, fileName, modifiedTime }, binary: items[0].binary }];\n}\nif (mime.startsWith('video/')) {\n  return [{ json: { ...items[0].json, route: 'video', source: 'drive', fileId, fileName, modifiedTime }, binary: items[0].binary }];\n}\nreturn [];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0],
      "id": "a0010001-0003-4a00-b003-000000000003",
      "name": "Code — MIME Route"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nif (item.json.route === 'mineru') return [item];\nreturn [];"
      },
      "type": "n8n-nodes-base.code", "typeVersion": 2,
      "position": [460, -400],
      "id": "a0010001-0010-4a00-b010-000000000010",
