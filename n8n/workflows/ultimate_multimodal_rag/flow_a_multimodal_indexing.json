    {
      "parameters": {
        "jsCode": "// NQ1D Metadata Enrichment + Content Hash\nconst crypto = require('crypto');\nconst item = $input.first();\nconst content = item.json.content || '';\nconst source = item.json.source || 'drive';\nconst fileId = item.json.fileId || '';\nconst docId = `${source}_${fileId}`;\n\n// Source URL\nlet sourceUrl = '';\nif (source === 'drive') sourceUrl = `https://drive.google.com/file/d/${fileId}/view`;\nelse if (source === 'notion') sourceUrl = `https://notion.so/${fileId.replace(/-/g, '')}`;\n\n// Section hierarchy from markdown headings\nconst headings = [];\nfor (const line of content.split('\\n')) {\n  const m = line.match(/^(#{1,3})\\s+(.+)/);\n  if (m) headings.push(m[2].trim());\n}\nconst hierarchy = headings.join(' > ') || item.json.fileName || '';\n\n// Content hash for dedup\nconst contentHash = crypto.createHash('sha256').update(content).digest('hex').substring(0, 16);\n\nreturn [{ json: {\n  content,\n  doc_id: docId,\n  title: item.json.fileName || '',\n  source,\n  source_url: sourceUrl,\n  media_type: item.json.media_type || 'text',\n  section_hierarchy: hierarchy,\n  content_preview: content.substring(0, 200),\n  content_hash: contentHash,\n  indexed_at: $now.toISO(),\n  source_modified_at: item.json.modifiedTime || '',\n  language: 'zh-TW',\n  parsed_by: item.json.parsed_by || 'direct'\n}}];"
      },
      "type": "n8n-nodes-base.code", "typeVersion": 2,
      "position": [2100, 0],
      "id": "a0010001-0060-4a00-b060-000000000060",
      "name": "Code — NQ1D Enrichment"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://{{ $vars.PINECONE_HOST }}/query",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "Api-Key", "value": "={{ $vars.PINECONE_API_KEY }}" },
          { "name": "Content-Type", "value": "application/json" }
        ]},
        "sendBody": true, "contentType": "json",
        "body": "={\n  \"vector\": {{ JSON.stringify(new Array(1536).fill(0)) }},\n  \"topK\": 1,\n  \"includeMetadata\": true,\n  \"filter\": { \"doc_id\": { \"$eq\": \"{{ $json.doc_id }}\" } }\n}"
      },
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2,
      "position": [2340, 0],
      "id": "a0010001-0061-4a00-b061-000000000061",
      "name": "HTTP — Pinecone Check Existing"
    },
    {
      "parameters": {
        "jsCode": "const matches = $json.matches || [];\nconst prev = $('Code — NQ1D Enrichment').item.json;\nconst currentHash = prev.content_hash;\n\nif (matches.length === 0) {\n  return [{ json: { ...prev, dedup_action: 'INDEX' } }];\n}\n\nconst existingHash = matches[0].metadata?.content_hash || '';\nif (existingHash === currentHash) {\n  return [{ json: { doc_id: prev.doc_id, dedup_action: 'SKIP', reason: 'content_hash unchanged' } }];\n}\n\nreturn [{ json: { ...prev, dedup_action: 'UPDATE' } }];"
      },
      "type": "n8n-nodes-base.code", "typeVersion": 2,
      "position": [2580, 0],
      "id": "a0010001-0062-4a00-b062-000000000062",
      "name": "Code — Dedup Decision"
    },
    {
      "parameters": {
        "jsCode": "const action = $json.dedup_action;\nif (action === 'SKIP') return [];\nreturn [$input.first()];"
      },
      "type": "n8n-nodes-base.code", "typeVersion": 2,
      "position": [2800, 0],
      "id": "a0010001-0063-4a00-b063-000000000063",
      "name": "Code — Dedup Route"
    },
    {
      "parameters": {
        "jsCode": "// Delete old vectors if UPDATE, then pass through\nif ($json.dedup_action === 'UPDATE') {\n  return [{ json: { ...($json), needsDelete: true } }];\n}\nreturn [{ json: { ...($json), needsDelete: false } }];"
      },
      "type": "n8n-nodes-base.code", "typeVersion": 2,
      "position": [3020, -200],
      "id": "a0010001-0064-4a00-b064-000000000064",
      "name": "Code — Check Delete"
