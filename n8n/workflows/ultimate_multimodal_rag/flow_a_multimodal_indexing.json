        ]},
        "sendBody": true, "contentType": "json",
        "body": "={\n  \"filter\": { \"doc_id\": { \"$eq\": \"{{ $json.doc_id }}\" } }\n}"
      },
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2,
      "position": [3240, -200],
      "id": "a0010001-0065-4a00-b065-000000000065",
      "name": "HTTP — Pinecone Delete Old"
