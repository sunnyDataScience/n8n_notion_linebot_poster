      "id": "a1b2c3d4-1001-4aaa-b001-000000000014",
      "name": "Set Audio Content",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1750, 400]
    },
    {
      "parameters": {
        "jsCode": "// Video Processing — Extract Audio Track\n// In production, use FFmpeg to extract the audio track from video.\n// For simplicity, we pass the video binary directly to Whisper.\n// OpenAI Whisper accepts common video formats (mp4, webm, etc.)\n// and will extract the audio internally.\n//\n// If you have FFmpeg available in your n8n instance:\n//   const { execSync } = require('child_process');\n//   execSync('ffmpeg -i input.mp4 -vn -acodec pcm_s16le output.wav');\n//\n// For now, pass through the binary data as-is.\n\nconst items = $input.all();\nreturn items.map(item => {\n  return {\n    json: {\n      ...item.json,\n      _video_note: 'Binary passed directly to Whisper — audio will be extracted by the API'\n    },\n    binary: item.binary\n  };\n});\n"
      },
      "id": "a1b2c3d4-1001-4aaa-b001-000000000015",
      "name": "Code — Extract Audio from Video",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1500, 600],
      "notes": "Placeholder for FFmpeg audio extraction. Currently passes video binary directly to Whisper API which can handle common video formats."
    },
