      "name": "HTTP — MinerU Poll"
    },
    {
      "parameters": {
        "jsCode": "const state = $json.state || $json.data?.state || '';\nif (state === 'done') {\n  const mdUrl = $json.data?.markdown_url || $json.data?.full_zip_url || '';\n  return [{ json: { ...($('Code — MIME Route').item.json), mineruState: 'done', markdownUrl: mdUrl } }];\n}\n// not done yet — return empty to stop (connect Wait node for retry)\nreturn [];"
      },
