      "parameters": {
        "jsCode": "const item = $input.first();\nif (item.json.route === 'text') return [{ json: { content: '', media_type: 'text', source: item.json.source, fileId: item.json.fileId, fileName: item.json.fileName, modifiedTime: item.json.modifiedTime, parsed_by: 'passthrough' }, binary: item.binary }];\nreturn [];"
