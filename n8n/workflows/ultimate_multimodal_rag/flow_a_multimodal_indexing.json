            }
          ],
          "combinator": "and"
        }
      },
      "id": "a1b2c3d4-1001-4aaa-b001-000000000019",
      "name": "Dedup Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [2750, 300],
      "notes": "Placeholder dedup logic: checks that doc_id and content are non-empty. In production, query your Notion Index Log DB to check if this doc_id + updated_at combination has already been indexed. Skip if already indexed."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a document processing assistant. Given the following content (which may be text, an image description, an audio transcript, or a video transcript), generate a JSON object with exactly these fields:\\n\\n1. \\\"summary\\\": A concise 2-3 sentence summary of the content in Traditional Chinese.\\n2. \\\"tags\\\": An array of 3-5 keyword tags in Traditional Chinese.\\n3. \\\"chunks\\\": An array of text chunks. Split the content into chunks of roughly 400-500 tokens each. Each chunk should be a coherent passage. If the content is short, return it as a single chunk.\\n\\nReturn ONLY valid JSON, no markdown fences.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Title: {{ $json.title }}\\nSource: {{ $json.source }}\\nMedia Type: {{ $json.media_type }}\\n\\nContent:\\n{{ $json.content }}\"\n    }\n  ],\n  \"temperature\": 0.3,\n  \"max_tokens\": 4096,\n  \"response_format\": { \"type\": \"json_object\" }\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 90000
        }
      },
      "id": "a1b2c3d4-1001-4aaa-b001-000000000020",
      "name": "LLM — Generate Summary & Tags",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3000, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "OPENAI_HEADER_AUTH_CREDENTIAL_ID",
          "name": "OpenAI Bearer Auth"
        }
