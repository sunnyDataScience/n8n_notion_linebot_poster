    {
      "parameters": {
        "jsCode": "const items = $input.all();\nfunction richTextToString(arr) {\n  if (!Array.isArray(arr)) return '';\n  return arr.map(rt => rt.plain_text ?? rt.text?.content ?? '').join('');\n}\nconst parts = [];\nfor (const item of items) {\n  const j = item.json || {};\n  const t = j.type;\n  if (!t) continue;\n  const block = j[t] || {};\n  if (Array.isArray(block.rich_text)) {\n    const s = richTextToString(block.rich_text).trim();\n    if (s) parts.push(s);\n    continue;\n  }\n  if (Array.isArray(block.title)) {\n    const s = richTextToString(block.title).trim();\n    if (s) parts.push(s);\n    continue;\n  }\n  if (Array.isArray(block.caption)) {\n    const s = richTextToString(block.caption).trim();\n    if (s) parts.push(s);\n    continue;\n  }\n}\nreturn [{ json: { concatenated_content: parts.join('\\n') } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [360, 1200],
      "id": "67e60d16-56ab-4eda-8660-81dc02cd23f0",
