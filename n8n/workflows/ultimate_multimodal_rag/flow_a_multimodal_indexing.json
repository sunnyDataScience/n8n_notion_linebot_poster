      "notes": "Uses gpt-4o with JSON mode to generate structured output: summary, tags, and chunked text. Configure httpHeaderAuth with Name=Authorization, Value=Bearer sk-YOUR_KEY."
    },
    {
      "parameters": {
        "jsCode": "// Parse LLM JSON output and prepare chunk items for embedding\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  try {\n    const llmResponse = typeof item.json.choices?.[0]?.message?.content === 'string'\n      ? JSON.parse(item.json.choices[0].message.content)\n      : item.json.choices?.[0]?.message?.content ?? {};\n\n    const summary = llmResponse.summary ?? '';\n    const tags = llmResponse.tags ?? [];\n    const chunks = llmResponse.chunks ?? [item.json.content ?? ''];\n\n    // Carry forward metadata from upstream\n    const meta = {\n      doc_id: item.json.doc_id ?? '',\n      title: item.json.title ?? '',\n      source: item.json.source ?? '',\n      media_type: item.json.media_type ?? '',\n      updated_at: item.json.updated_at ?? '',\n      original_url: item.json.original_url ?? '',\n      summary: summary,\n      tags: tags,\n      chunk_count: chunks.length\n    };\n\n    for (let i = 0; i < chunks.length; i++) {\n      results.push({\n        json: {\n          ...meta,\n          chunk_index: i,\n          chunk_text: chunks[i],\n          vector_id: `${meta.doc_id}_chunk_${i}`,\n          indexed_at: new Date().toISOString()\n        }\n      });\n    }\n  } catch (error) {\n    // If JSON parsing fails, treat entire content as single chunk\n    results.push({\n      json: {\n        doc_id: item.json.doc_id ?? '',\n        title: item.json.title ?? '',\n        source: item.json.source ?? '',\n        media_type: item.json.media_type ?? '',\n        updated_at: item.json.updated_at ?? '',\n        original_url: item.json.original_url ?? '',\n        summary: '',\n        tags: [],\n        chunk_count: 1,\n        chunk_index: 0,\n        chunk_text: item.json.content ?? '',\n        vector_id: `${item.json.doc_id ?? 'unknown'}_chunk_0`,\n        indexed_at: new Date().toISOString(),\n        _parse_error: error.message\n      }\n    });\n  }\n}\n\nreturn results;\n"
      },
