    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {},
        "messages": {
          "values": [
            {
              "content": "=You are a document indexing assistant. Given the following document content, produce a JSON object with three fields:\n1. \"summary\": a concise 2-3 sentence summary\n2. \"tags\": an array of 3-8 relevant tags\n3. \"chunks\": an array of text chunks, each 300-500 characters, covering the full document\n\nDocument title: {{ $json.title }}\nDocument content:\n{{ $json.content }}\n\nRespond with valid JSON only."
            }
          ]
        }
      },
      "id": "llm-openai-1",
      "name": "Generate Summary & Chunks",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
        1500,
        150
      ],
      "credentials": {
        "openAiApi": {
          "id": "openai_api",
          "name": "openai_api"
        }
      }
    },
    {
