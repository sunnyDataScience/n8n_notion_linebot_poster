          "id": "pinecone_api",
          "name": "pinecone_api"
        }
      }
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "create",
        "databaseId": "YOUR_NOTION_INDEX_LOG_DATABASE_ID",
        "propertiesUi": {
