              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-notion-1",
      "name": "Set Notion Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        600,
        300
