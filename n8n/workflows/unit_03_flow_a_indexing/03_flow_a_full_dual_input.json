        "model": "text-embedding-3-small",
        "options": {}
      },
      "id": "embeddings-openai-1",
      "name": "Embeddings OpenAI",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1,
      "position": [
        1750,
        150
      ],
      "credentials": {
        "openAiApi": {
          "id": "openai_api",
          "name": "openai_api"
        }
      }
    },
    {
      "parameters": {
        "mode": "upsert",
        "pineconeIndex": "YOUR_PINECONE_INDEX_NAME",
        "options": {
          "metadata": {
            "metadataValues": [
              {
                "name": "doc_id",
                "value": "={{ $json.doc_id }}"
              },
              {
                "name": "title",
                "value": "={{ $json.title }}"
              },
              {
                "name": "source",
                "value": "={{ $json.source }}"
              },
              {
                "name": "summary",
                "value": "={{ $json.summary }}"
              },
              {
                "name": "tags",
                "value": "={{ $json.tags }}"
              }
            ]
          }
        }
      },
      "id": "pinecone-upsert-1",
      "name": "Pinecone Vector Store Upsert",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePinecone",
      "typeVersion": 1,
      "position": [
        2000,
        150
      ],
      "credentials": {
