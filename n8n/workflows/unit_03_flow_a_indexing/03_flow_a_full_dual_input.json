            {
              "id": "notion-doc-id",
              "name": "doc_id",
              "value": "=notion_{{ $('Notion Trigger').item.json.id }}",
              "type": "string"
            },
            {
              "id": "notion-title",
              "name": "title",
              "value": "={{ $('Notion Trigger').item.json.properties.Name.title[0].plain_text }}",
              "type": "string"
            },
            {
              "id": "notion-source",
              "name": "source",
