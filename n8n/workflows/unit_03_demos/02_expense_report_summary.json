      "id": "a1b2c3d4-0001-4000-8000-000000000005",
      "name": "Google Sheets - Read Expenses",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [480, 350],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "google_sheets_oauth2",
          "name": "Google Sheets OAuth2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Get previous month (since this runs on 1st of current month)\nconst now = new Date();\nconst targetYear = now.getMonth() === 0 ? now.getFullYear() - 1 : now.getFullYear();\nconst targetMonth = now.getMonth() === 0 ? 12 : now.getMonth(); // 1-based\nconst targetPrefix = `${targetYear}-${String(targetMonth).padStart(2, '0')}`;\n\n// Filter rows for the target month\nconst rows = $input.all().filter(item => {\n  const date = item.json.date || '';\n  return date.startsWith(targetPrefix);\n});\n\n// Group by category and sum amounts\nconst summary = {};\nlet grandTotal = 0;\n\nfor (const row of rows) {\n  const category = row.json.category || 'Uncategorized';\n  const amount = parseFloat(row.json.amount) || 0;\n  if (!summary[category]) {\n    summary[category] = 0;\n  }\n  summary[category] += amount;\n  grandTotal += amount;\n}\n\n// Format summary text\nconst monthLabel = `${targetYear}/${String(targetMonth).padStart(2, '0')}`;\nlet text = `${monthLabel} Monthly Expense Summary\\n${'='.repeat(30)}\\n`;\n\nconst sorted = Object.entries(summary).sort((a, b) => b[1] - a[1]);\nfor (const [cat, total] of sorted) {\n  text += `${cat}: NT$${total.toLocaleString()}\\n`;\n}\ntext += `${'='.repeat(30)}\\nTotal: NT$${grandTotal.toLocaleString()}`;\n\nreturn [{\n  json: {\n    month: monthLabel,\n    summary_text: text,\n    category_breakdown: summary,\n    grand_total: grandTotal,\n    row_count: rows.length\n  }\n}];"
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000006",
      "name": "Code - Summarize by Category",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
