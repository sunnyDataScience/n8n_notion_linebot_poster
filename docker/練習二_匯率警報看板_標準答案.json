        -608,
        400
      ]
    },
    {
      "parameters": {
        "url": "https://tw.rter.info/capi.php",
        "options": {}
      },
      "id": "p2-http-0001",
      "name": "GET — 即時匯率 JSON",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -304,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// Step 3: Extract 3 currencies from 200+ pairs\nconst raw = $input.first().json;\n\n// Handle both cases: n8n auto-parsed JSON or string in data field\nconst data = (typeof raw.data === 'string') ? JSON.parse(raw.data) : raw;\n\nreturn [{\n  json: {\n    jpy_rate: data.USDJPY.Exrate,\n    jpy_label: '1 USD = ¥' + data.USDJPY.Exrate,\n    twd_rate: data.USDTWD.Exrate,\n    twd_label: '1 USD = NT$' + data.USDTWD.Exrate,\n    krw_rate: data.USDKRW.Exrate,\n    krw_label: '1 USD = ₩' + data.USDKRW.Exrate,\n    updated: data.USDJPY.UTC\n  }\n}];\n"
      },
      "id": "p2-code-0001",
      "name": "Code — 篩選三種幣別",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        400
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "condition-jpy",
              "leftValue": "={{ $json.jpy_rate }}",
              "rightValue": 155,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "p2-if-0001",
      "name": "IF — 日圓 > 155？",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        304,
        400
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "set-verdict",
              "name": "verdict",
              "value": "=好消息！日圓便宜了，可以換匯！",
              "type": "string"
            },
            {
              "id": "set-jpy",
              "name": "jpy",
              "value": "={{ $json.jpy_label }}",
              "type": "string"
            },
            {
              "id": "set-twd",
              "name": "twd",
              "value": "={{ $json.twd_label }}",
              "type": "string"
            },
            {
              "id": "set-krw",
